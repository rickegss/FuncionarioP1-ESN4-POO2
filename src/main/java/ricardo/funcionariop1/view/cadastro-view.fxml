<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="551.0" prefWidth="808.0" spacing="18.0" style="-fx-base: #1a1d23; -fx-background: #0f1115; -fx-control-inner-background: #1a1d23; -fx-accent: #5b7cfa; -fx-focus-color: #5b7cfa; -fx-faint-focus-color: transparent; -fx-background-color: #0f1115; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ricardo.funcionariop1.controller.CadastroController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f2f3f5;" text="Cadastro de Funcionário" />
        <VBox spacing="12.0" style="-fx-background-color: #161920; -fx-background-radius: 12; -fx-border-color: #23272f; -fx-border-radius: 12;">
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
            </padding>
            <children>
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="DADOS PESSOAIS" />
                <GridPane hgap="14.0" vgap="6.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints minHeight="28.0" valignment="BOTTOM" />
                        <RowConstraints />
                    </rowConstraints>
                    <children>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="Matrícula" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="Nome Completo" GridPane.columnIndex="1" GridPane.columnSpan="2" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="CPF" GridPane.columnIndex="3" />
                        <TextField fx:id="txtMatricula" style="-fx-background-radius: 8; -fx-padding: 8 10;" GridPane.rowIndex="1" />
                        <TextField fx:id="txtNome" style="-fx-background-radius: 8; -fx-padding: 8 10;" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="1" />
                        <TextField fx:id="txtCPF" promptText="000.000.000-00" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-prompt-text-fill: #6b7280;" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="Cargo" GridPane.rowIndex="2" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="Salário" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="Data de Nascimento" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="Data de Contratação" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                        <TextField fx:id="txtCargo" style="-fx-background-radius: 8; -fx-padding: 8 10;" GridPane.rowIndex="3" />
                        <TextField fx:id="txtSalario" promptText="0,00" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-prompt-text-fill: #6b7280;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <DatePicker fx:id="dpNascimento" maxWidth="Infinity" style="-fx-background-radius: 8;" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                        <DatePicker fx:id="dpContratacao" maxWidth="Infinity" style="-fx-background-radius: 8;" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                    </children>
                </GridPane>
            </children>
        </VBox>
        <VBox spacing="12.0" style="-fx-background-color: #161920; -fx-background-radius: 12; -fx-border-color: #23272f; -fx-border-radius: 12;">
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
            </padding>
            <children>
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" text="ENDEREÇO" />
                <GridPane hgap="14.0" vgap="6.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints minHeight="28.0" valignment="BOTTOM" />
                        <RowConstraints />
                    </rowConstraints>
                    <children>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="Logradouro" GridPane.columnSpan="2" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="Número" GridPane.columnIndex="2" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="CEP" GridPane.columnIndex="3" />
                        <TextField fx:id="txtLogradouro" style="-fx-background-radius: 8; -fx-padding: 8 10;" GridPane.columnSpan="2" GridPane.rowIndex="1" />
                        <TextField fx:id="txtNumero" style="-fx-background-radius: 8; -fx-padding: 8 10;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField fx:id="txtCEP" promptText="00000-000" style="-fx-background-radius: 8; -fx-padding: 8 10; -fx-prompt-text-fill: #6b7280;" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="Complemento" GridPane.rowIndex="2" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="Bairro" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="Cidade" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="Estado" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                        <TextField fx:id="txtComplemento" style="-fx-background-radius: 8; -fx-padding: 8 10;" GridPane.rowIndex="3" />
                        <TextField fx:id="txtBairro" style="-fx-background-radius: 8; -fx-padding: 8 10;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <TextField fx:id="txtCidade" style="-fx-background-radius: 8; -fx-padding: 8 10;" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                        <ComboBox fx:id="cbEstado" maxWidth="Infinity" style="-fx-background-radius: 8;" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                    </children>
                </GridPane>
            </children>
        </VBox>
        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnCadCadastrar" mnemonicParsing="false" onAction="#cadastrar" style="-fx-background-color: #e6e8ec; -fx-background-radius: 8; -fx-text-fill: #0f1115; -fx-font-weight: bold; -fx-padding: 9 22; -fx-cursor: hand;" text="Cadastrar" />
                <Button fx:id="btnCadLimpar" mnemonicParsing="false" onAction="#limpar" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-border-color: #2a2e37; -fx-border-radius: 8; -fx-text-fill: #c4c8d0; -fx-padding: 9 22; -fx-cursor: hand;" text="Limpar" />
            </children>
        </HBox>
    </children>
</VBox>