<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="551.0" prefWidth="808.0" spacing="16.0" style="-fx-base: #1a1d23; -fx-background: #0f1115; -fx-control-inner-background: #1a1d23; -fx-accent: #5b7cfa; -fx-focus-color: #5b7cfa; -fx-faint-focus-color: transparent; -fx-background-color: #0f1115; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ricardo.funcionariop1.controller.ListagemController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f2f3f5;" text="Funcionários Cadastrados" />
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="Matrícula" />
                <TextField fx:id="txtBuscaMatricula" prefWidth="220.0" promptText="Digite a matrícula" style="-fx-background-radius: 8; -fx-padding: 8 10;" />
                <Button fx:id="btnBuscar" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-border-color: #2a2e37; -fx-border-radius: 8; -fx-text-fill: #c4c8d0; -fx-padding: 9 22; -fx-cursor: hand;" text="Buscar" />
            </children>
        </HBox>
        <TableView fx:id="tabelaFuncionarios" style="-fx-background-color: #161920; -fx-background-radius: 10; -fx-border-color: #23272f; -fx-border-radius: 10; -fx-fixed-cell-size: 40;" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colMatricula" prefWidth="134.0" text="Matrícula" />
                <TableColumn fx:id="colNome" prefWidth="340.0" text="Nome" />
                <TableColumn fx:id="colCargo" prefWidth="206.0" text="Cargo" />
                <TableColumn fx:id="colSalario" prefWidth="161.0" text="Salário" />
            </columns>
        </TableView>
        <HBox>
            <children>
                <Button fx:id="btnExcluir" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-border-color: #4a2a2e; -fx-border-radius: 8; -fx-text-fill: #e07a85; -fx-padding: 9 22; -fx-cursor: hand;" text="Excluir Selecionado" />
            </children>
        </HBox>
    </children>
</VBox>