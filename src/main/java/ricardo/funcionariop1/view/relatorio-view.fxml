            </children>
        </VBox>
        <Label fx:id="lblResultado" style="-fx-font-size: 12px; -fx-text-fill: #8b92a0;" text="Resultado" />
        <TextArea fx:id="txtResultado" editable="false" style="-fx-control-inner-background: #161920; -fx-background-radius: 8; -fx-font-family: 'Consolas';" VBox.vgrow="ALWAYS" />
    </children>
