<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="layoutPrincipal" prefHeight="640.0" prefWidth="960.0" style="-fx-base: #1a1d23; -fx-background: #0f1115; -fx-control-inner-background: #1a1d23; -fx-accent: #5b7cfa; -fx-focus-color: #5b7cfa; -fx-faint-focus-color: transparent; -fx-background-color: #0f1115; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ricardo.funcionariop1.controller.MainController">
    <left>
        <VBox prefWidth="170.0" spacing="6.0" style="-fx-background-color: #14161b; -fx-border-color: #23272f; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="24.0" />
            </padding>
            <children>
                <Label style="-fx-text-fill: #f2f3f5; -fx-font-size: 15px; -fx-font-weight: bold;" text="Funcionários">
                    <padding>
                        <Insets bottom="16.0" left="14.0" />
                    </padding>
                </Label>
                <Button fx:id="btnCadastro" alignment="CENTER_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#abrirCadastro" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-text-fill: #c4c8d0; -fx-padding: 10 14; -fx-cursor: hand;" text="Cadastro" />
                <Button fx:id="btnListagem" alignment="CENTER_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#abrirListagem" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-text-fill: #c4c8d0; -fx-padding: 10 14; -fx-cursor: hand;" text="Listagem" />
                <Button fx:id="btnRelatorios" alignment="CENTER_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#abrirRelatorios" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-text-fill: #c4c8d0; -fx-padding: 10 14; -fx-cursor: hand;" text="Relatórios" />
            </children>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="areaConteudo" style="-fx-background-color: #0f1115;" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>